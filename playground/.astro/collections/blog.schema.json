{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "categories": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "imageDecorative": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "unlisted",
        "scheduled"
      ]
    },
    "publishAt": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "shareImage": {
      "type": "string"
    },
    "shareTitle": {
      "type": "string"
    },
    "shareDescription": {
      "type": "string"
    },
    "keyword": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "canonical": {
      "type": "string"
    },
    "noindex": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}