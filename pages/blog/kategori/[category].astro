---
// A tag's page on the blog, drawn by the theme (src/themes/<theme>/templates/Category.astro).
import Category from '@theme/templates/Category.astro';
import { getCategories, getPosts } from '@interstellarcms/cms/site/content';

export async function getStaticPaths() {
  const [categories, posts] = await Promise.all([getCategories(), getPosts()]);
  return categories.map((c) => ({
    params: { category: c.slug },
    props: { name: c.name, posts: posts.filter((p) => p.data.categories.includes(c.slug)) },
  }));
}

const { category } = Astro.params;
const { name, posts } = Astro.props;
---

<Category category={category} name={name} posts={posts} />
