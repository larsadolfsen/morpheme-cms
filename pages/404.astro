---
// The page for an address that does not exist: the page chosen as the 404 page (packages/editor/site/standardPages.ts), drawn by the
// theme (src/themes/<theme>/templates/NotFound.astro).
import NotFound from '@theme/templates/NotFound.astro';
import { notFoundPage } from '@morphemecms/cms/site/standardPages';

const page = await notFoundPage();
---

<NotFound {...page} />
