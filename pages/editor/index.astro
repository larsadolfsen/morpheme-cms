---
// /editor/ was the editor's address; it is /edit/ now. The site's Worker sends /editor/ and everything under it on to /edit/ (308),
// so this page is only seen when the Worker is an older one than the build (packages/editor/worker/index.js): it sends on with the
// query and what is after "#" (the open screen).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>The editor has moved</title>
    <script is:inline>
      location.replace('/edit/' + location.search + location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/edit/" />
    </noscript>
  </head>
  <body>
    <p>
      The editor has moved to <a href="/edit/">/edit/</a>.
    </p>
  </body>
</html>
