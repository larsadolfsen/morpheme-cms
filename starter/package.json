{
  "name": "morpheme-site",
  "version": "1.0.0",
  "description": "A site with Morpheme CMS.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "morpheme images",
    "dev": "astro dev",
    "prebuild": "morpheme check:content && morpheme images",
    "build": "astro build && morpheme after-build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "check": "prettier --check . && astro sync && tsc --noEmit -p . && npm run check:content && npm run check:editor && npm run check:worker",
    "check:content": "morpheme check:content",
    "check:editor": "morpheme check:editor",
    "check:worker": "morpheme check:worker",
    "check:screens": "morpheme check:screens",
    "check:themes": "morpheme check:themes",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.3.0",
    "@milkdown/kit": "^7.22.3",
    "@morphemecms/cms": "0.1.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "jsdom": "^29.1.1",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "vite": "^8.3.4",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2"
  }
}
