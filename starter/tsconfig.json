{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // As the CMS resolves them when it builds the site (site/theme.mjs): the site's own part, else the CMS's standard
    // one; the theme in use (here the standard theme, Material), else the standard theme.
    "paths": {
      "@site/*": ["./src/site/*", "./node_modules/@morphemecms/cms/defaults/*"],
      "@data/*": ["./src/data/*"],
      "@theme/*": ["./node_modules/@morphemecms/cms/theme/*"],
      "@saturn/*": ["./node_modules/@morphemecms/cms/theme/*"]
    }
  }
}
