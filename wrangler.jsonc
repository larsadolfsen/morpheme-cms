// The CMS's demo on Cloudflare, the Worker morpheme-demo: `npm run build` (scripts/demo-build.mjs) builds the demo into
// .morpheme/demo/site/, and `wrangler deploy` uploads its dist/ as static assets with the CMS's Worker in front, as a site
// from the starter has it (starter/wrangler.jsonc). Not in the package.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morpheme-demo",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The package as the build copied it there (demo-build.mjs), as a site has it from npm.
  "main": "node_modules/@morphemecms/cms/worker/index.js",
  // What the Worker has from the demo: its settings and src/site/worker.js.
  "alias": {
    "@site/config": "./.morpheme/demo/site/src/site/config.ts",
    "@site/worker": "./.morpheme/demo/site/src/site/worker.js",
  },
  // Keep the variables added in the dashboard (Settings → Variables and secrets) on every deploy.
  "keep_vars": true,
  "observability": { "logs": { "enabled": true, "invocation_logs": true } },
  // NOT_FOUND: the addresses visitors came to that do not exist, and each person's dashboard on the editor's start screen
  // (`dashboard:<id>`). The demo's first deploy created the namespace (as morpheme-demo-dashboard), and an id-less binding
  // made the deploys after it fail on Cloudflare, so the demo binds it by its id. It was bound as DASHBOARD before; the keys
  // are the same `dashboard:<id>`, so dashboards stored then are still there. No other KV, D1, R2 or crons: the Worker does
  // without them (push.js, consent.js), and the demo's made-up repository gets no scheduled commits.
  "kv_namespaces": [{ "binding": "NOT_FOUND", "id": "a944a708b0c1494d87f93d0f4e07e106" }],
  // Builds of other branches than main run `wrangler preview`, which needs this block.
  "previews": {},
  // Cloudflare's builds of other branches have no build command of their own, so wrangler builds the demo first.
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./.morpheme/demo/site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": true,
  },
}
