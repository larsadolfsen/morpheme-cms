{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "interstellar-demo",
	"main": "./playground/worker.mjs",
	// "r2_buckets": [{ "binding": "FILES", "bucket_name": "interstellar-demo-files", "jurisdiction": "eu" }],
	"assets": {
		"directory": "./playground/dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "force-trailing-slash",
		"run_worker_first": [
			"/api/*",
			"/version.json",
			"/editor/*.json",
			"/editor/sw.js"
		]
	},
	"observability": {
		"enabled": true
	}
}