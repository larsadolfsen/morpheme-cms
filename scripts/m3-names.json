    {
      "id": 2,
      "question": "The tokens --mo-comp-button-medium-container-height and --mo-comp-button-small-container-height collide on --mo-comp-button-small-container-height (both 2.5 rem today): which declaration wins in the rename?",
      "where": "tokens"
    },
    {
      "id": 3,
      "question": "Our large (64 dp) and xlarge (88 dp) buttons keep the names but have M3 heights 96 and 136 dp; keep the names and the values, or change the values?",
      "where": "Button.size"
    },
    {
      "id": 4,
      "question": "--mo-comp-button-padding becomes both leading-space and trailing-space of small (one old token, two new).",
      "where": "tokens (array values)"
    },
    {
      "id": 5,
      "question": "Our classes use the family word (card, chip, text-field, tabs, tooltip, select) where M3 names tokens by kind (filled-card, assist-chip...). Keep the family word and the kind as mo-is-<kind>?",
      "where": "classes"
    },
    {
      "id": 6,
      "question": "Navigation bar and rail take the Expressive names nav-bar and nav-rail (collapsed). Confirm.",
      "where": "classes, tokens"
    },
    {
      "id": 7,
      "question": "Sheets: bottom-sheet and side-sheet become mo-sheet with mo-is-bottom / mo-is-side (M3 has one sheet component with kinds). Confirm.",
      "where": "classes"
    },
    {
      "id": 8,
      "question": "Kinds written as parts today (mo-button__text) become mo-is-<kind>; other kinds (mo-icon-button__standard, mo-fab__primary) stay parts until batch 3.",
