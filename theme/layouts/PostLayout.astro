---
// Blog post template. A narrow reading column, the site's owner as author; related posts in the footer.
// data-editor marks what the editor's preview fills in with what is in its form ("Forhåndsvis",
// packages/editor/src/pagePreview.tsx): the heading, the picture and the text.
import { firstImage, heroImage, picturesOf } from '@morpheme/cms/site/images.mjs';
import Base from '@theme/layouts/Base.astro';
import Icon from '@theme/components/Icon.astro';
import Img from '@theme/components/Img.astro';
import EndBlock from '@theme/components/EndBlock.astro';
import { categoryName, getPosts, postPath, stateOf, type Post } from '@morpheme/cms/site/content';
import PostMeta from '@theme/components/PostMeta';
import Chip from '@theme/ui/Chip';
import { postViewOf } from '@theme/components/loadPosts';
import { site } from '@morpheme/cms/site/site';
import { isBlogCategory } from '@morpheme/cms/site/categories';
import { blogPosting } from '@morpheme/cms/site/schema';
import { siteT } from '@morpheme/cms/src/i18n';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, date, updated, categories } = post.data;
// A decorative picture (imageDecorative) has no alternative text.
const imageAlt = post.data.imageDecorative ? undefined : post.data.imageAlt;
// The pills under the post: only the blog categories (the others have no page).
const onBlog = categories.filter(isBlogCategory);
// Some posts also have their featured image (or another version of it) inside the text; never show it twice.
const image = heroImage(post.data.image, post.body);

// Related: most shared categories first, then newest.
const related = (await getPosts())
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: p.data.categories.filter((c) => categories.includes(c)).length }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.date.valueOf() - a.p.data.date.valueOf())
  .slice(0, 3)
  .map(({ p }) => p);
---

<Base
  title={title}
  description={description}
  seoTitle={post.data.seoTitle}
  seoDescription={post.data.seoDescription}
  canonical={post.data.canonical}
  image={post.data.image || firstImage(post.body)}
  pictures={[post.data.image, ...picturesOf(post.body)]}
  imageAlt={post.data.image ? imageAlt : undefined}
  shareImage={post.data.shareImage}
  shareTitle={post.data.shareTitle}
  shareDescription={post.data.shareDescription}
  type="article"
  published={date}
  modified={updated}
  noindex={stateOf(post.data) === 'unlisted' || post.data.noindex}
  crumbs={[{ name: siteT.theme.blog, href: '/blog/' }]}
  schema={[
    blogPosting({
      path: postPath(post),
      title,
      description,
      date,
      updated,
      image: post.data.image,
      categories: categories.map(categoryName),
    }),
  ]}
>
  <article>
    <header class="mx-auto max-w-3xl px-5 pt-8 md:px-8 md:pt-14">
      <a href="/blog/" class="inline-flex items-center gap-1.5 type-body-medium text-muted hover:text-accent">
        <Icon name="arrow-left" size={16} /> {siteT.theme.blog}
      </a>
      <h1 data-editor="heading" class="theme-title mt-3">
        {title}
      </h1>
      <div class="mt-6 flex items-center gap-3">
        {site.portrait && (
          <Img src={site.portrait} alt="" loading="eager" class="size-11 rounded-full object-cover object-[50%_20%]" sizes="44px" />
        )}
        <div class="leading-snug">
          <span class="block font-medium">{site.name}</span>
          <PostMeta post={postViewOf(post)} />
        </div>
      </div>
    </header>

    {image && (
      <div data-editor="image" class="mx-auto mt-8 max-w-5xl px-5 md:mt-12 md:px-8">
        <Img
          src={image}
          alt={imageAlt ?? ''}
          fetchpriority="high"
          class="aspect-[16/10] w-full rounded-(--theme-picture-radius) object-cover md:aspect-[16/9]"
          sizes="(min-width: 1024px) 960px, calc(100vw - 40px)"
        />
      </div>
    )}

    <div data-editor="text" class="prose mx-auto mt-10 max-w-3xl px-5 md:mt-14 md:px-8">
      <slot />
    </div>

    <footer class="mx-auto mt-12 max-w-3xl px-5 md:px-8">
      {onBlog.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Tags">
          {onBlog.map((c) => (
            <li>
              <Chip href={`/blog/kategori/${c}/`} label={categoryName(c)} />
            </li>
          ))}
        </ul>
      )}
    </footer>
  </article>

  {site.postEnd && <EndBlock type={site.postEnd} />}

  {related.length > 0 && (
    <Fragment slot="footer-column">
      <p class="footer-heading font-medium">{siteT.theme.relatedPosts}</p>
      <ul class="mt-3 space-y-2.5 text-muted">
        {related.map((p) => (
          <li>
            <a href={postPath(p)} class="hover:text-accent">
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog/" class="mt-4 inline-flex items-center gap-1.5 font-medium text-accent">
        {siteT.theme.seeAll} <Icon name="arrow-right" size={16} />
      </a>
    </Fragment>
  )}
</Base>
