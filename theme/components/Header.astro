---
// The header in Material: a small top app bar (ui/TopAppBar.tsx, m3.material.io/components/top-app-bar) with the navigation drawer's
// button first (MobileMenu.tsx) on a phone, a tablet and when the menu does not fit, the logo, the menu's items with
// the open page in an active indicator on a computer (an item with sub-pages has a button with a caret that opens them
// in a menu (ui/Menu.tsx), also on hover), and the call to action at the end (HeaderCta.tsx): the phone number as a text
// button and the header's button after it; without the menu and its button when "Hovedmenu" is turned off. Under it the
// bar of "Mobilmenu" (MobileNav.astro), when it is on. Under it, "Book en tid" as an extended FAB at the bottom right of
// the screen (ui/Fab.tsx, m3.material.io/components/extended-fab), which shows only its icon while the page scrolls down.
// Not on the booking page and the thank-you page; on a phone with a bar at the bottom of the screen, the bar's first
// button is the FAB instead (global.css). header.json (optional, site/header.mjs) turns the call to action's button and
// phone number on and off (they are at the bottom of the navigation drawer too) and puts the menu button at the end (the
// drawer then opens from that side); data-editor marks the header, the menu button, the menu's items (header-nav) and
// the call to action (header-cta) for the editor's preview; their classes are in headerParts.ts, which the preview shares.
import Icon from '@theme/components/Icon.astro';
import MobileMenu from '@theme/components/MobileMenu.tsx';
import Logo from '@theme/components/Logo.astro';
import Container from '@theme/components/Container.astro';
import MobileNav from '@theme/components/MobileNav.astro';
import { topAppBarClass } from '@theme/ui/TopAppBar';
import { menuClass, menuItemClass } from '@theme/ui/Menu';
import { extendedFabClass } from '@theme/ui/Fab';
import HeaderCta from '@theme/components/HeaderCta';
import { headerMenuClass } from '@theme/components/headerParts';
import { loadButtons } from '@morphemecms/cms/src/standard/buttons/load';
import { site, nav, navShown, header } from '@morphemecms/cms/site/site';
import { siteT } from '@morphemecms/cms/src/i18n';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
// The call to action (header.json): the header's button (none when it is off) and the phone number (when it is on).
const button = header.button ? (await loadButtons([{ ...header.button, kind: 'filled' }]))[0] : undefined;
// The phone number (Business › Contact): it calls on a phone, and leads to the contact page (Default pages) on a computer.
const phone =
  header.phone && site.phone
    ? { number: site.phone, href: site.phoneHref, label: `${site.labels.call} ${site.phone}`, page: site.contactPath || undefined }
    : undefined;
const menuEnd = header.menuSide === 'end';
const menuProps = {
  items: nav,
  current,
  side: header.menuSide,
  button,
  phone,
  name: site.name,
  role: site.role,
  texts: {
    open: siteT.theme.openMenu,
    close: siteT.theme.closeMenu,
    menu: siteT.theme.mainMenu,
    drawer: siteT.theme.mobileMenu,
    subpages: nav.map((item) => siteT.theme.subpagesOf(item.label)),
  },
};
const fab = !current.startsWith(site.bookingPath) && current !== '/tak/';
---

<header data-header data-editor="header" class:list={[topAppBarClass, 'group/header sticky top-0 z-[43]']}>
  <Container as="div" data-header-row class="flex h-16 items-center gap-1">
    {navShown && !menuEnd && (
      <div data-editor="header-menu" class={headerMenuClass('start')}>
        <MobileMenu client:interact {...menuProps} />
      </div>
    )}
    <a href="/" class="md-top-app-bar-title mr-auto large:shrink-0 large:whitespace-nowrap">
      <Logo />
    </a>

    {navShown && (
      <nav
        aria-label={siteT.theme.mainMenu}
        data-editor="header-nav"
        class="hidden shrink-0 large:block large:group-data-crowded/header:hidden"
      >
        <ul class="flex items-center gap-1">
          {nav.map((item, i) => (
            <li class="group relative flex items-center" data-nav-item>
              <a
                href={item.href}
                class:list={['md-nav-item', item.children && 'md-nav-item-parent']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="md-nav-toggle"
                  aria-expanded="false"
                  aria-controls={`menu-${i}`}
                  aria-label={siteT.theme.subpagesOf(item.label)}
                  data-nav-toggle
                >
                  <Icon name="caret-down" size={20} />
                </button>
              )}
              {item.children && (
                // A menu (m3.material.io/components/menus) that opens on hover and with the button before it.
                <div
                  id={`menu-${i}`}
                  class:list={[
                    'md-menu-anchor invisible absolute top-full pt-1 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100',
                    i >= nav.length - 2 ? 'right-0' : 'left-0',
                  ]}
                >
                  <ul class={menuClass}>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class={menuItemClass} aria-current={current === child.href ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>
    )}

    <HeaderCta button={button} phone={phone} />
    {navShown && menuEnd && (
      <div data-editor="header-menu" class={headerMenuClass('end')}>
        <MobileMenu client:interact {...menuProps} />
      </div>
    )}
  </Container>
  <MobileNav />
</header>
<script is:inline>
  // When the menu items (set in the editor) don't fit on one line next to the logo, the header
  // shows the menu button instead, as on smaller screens. Runs before the first paint.
  {
    const header = document.querySelector('[data-header]');
    const row = header.querySelector('[data-header-row]');
    const fit = () => {
      header.removeAttribute('data-crowded');
      header.toggleAttribute('data-crowded', row.scrollWidth > row.clientWidth);
    };
    fit();
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(fit);
      ro.observe(header);
      const menu = row.querySelector('nav ul');
      if (menu) ro.observe(menu);
    }
    document.fonts?.ready.then(fit);
  }
</script>
<script>
  // A menu's button opens and closes it (aria-expanded); Escape, a click outside it and focus leaving it close it.
  const items = [...document.querySelectorAll<HTMLElement>('[data-nav-item]:has([data-nav-toggle])')];
  const setOpen = (item: HTMLElement, open: boolean) => {
    item.toggleAttribute('data-open', open);
    item.querySelector('[data-nav-toggle]')?.setAttribute('aria-expanded', String(open));
  };
  for (const item of items) {
    const toggle = item.querySelector<HTMLElement>('[data-nav-toggle]')!;
    toggle.addEventListener('click', () => {
      const open = !item.hasAttribute('data-open');
      for (const other of items) if (other !== item) setOpen(other, false);
      setOpen(item, open);
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) setOpen(item, false);
    });
    item.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !item.hasAttribute('data-open')) return;
      setOpen(item, false);
      toggle.focus();
    });
  }
  document.addEventListener('click', (e) => {
    for (const item of items) if (!item.contains(e.target as Node)) setOpen(item, false);
  });
</script>

{fab && (
  <a href={site.bookingPath} data-open="booking" data-fab class={extendedFabClass()}>
    <Icon name="calendar-blank" size={24} />
    <span class="extended-fab-label">{site.labels.book}</span>
  </a>
)}

<script>
  // The FAB shows only its icon while the page scrolls down, and its label again when it scrolls up or is at the top.
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  if (fab) {
    let last = scrollY;
    addEventListener(
      'scroll',
      () => {
        if (Math.abs(scrollY - last) < 8) return;
        fab.toggleAttribute('data-collapsed', scrollY > last && scrollY > 64);
        last = scrollY;
      },
      { passive: true },
    );
  }
</script>
