---
// A block a page can have, as a section of the front page (`pageBlocks` in packages/editor/defaults/collections.ts): the standard
// one's or the app's (Block.astro, by its type), in the front page's width and space, with its shared texts; a colour under its heading (`sectionColor`) goes to Section, not to the block.
import Block from '@morphemecms/cms/src/standard/Block.astro';
import Section from '@theme/components/Section.astro';
import { blockTexts } from '@morphemecms/cms/site/site';

interface Props {
  section: { type: string; hidden?: boolean; sectionColor?: string } & Record<string, unknown>;
  class?: string;
}
const { type, hidden, sectionColor, ...props } = Astro.props.section;
---

<Section class={Astro.props.class} color={sectionColor}>
  <div class="block-place">
    <Block type={type} props={props} texts={blockTexts[type]} />
  </div>
</Section>
