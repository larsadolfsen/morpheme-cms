---
// A text the site's owner writes: an optional heading and Markdown, in a panel when its heading has a colour (`sectionColor`).
import Section from '@theme/components/Section.astro';
import Markdown from '@theme/components/Markdown.astro';
import type { HomeSection } from '@morphemecms/cms/site/home';

type Props = Extract<HomeSection, { type: 'text' }> & { class?: string };
const { heading, body, sectionColor, class: className } = Astro.props;
---

<Section title={heading} class={className} color={sectionColor}>
  <Markdown body={body} class={heading && 'mt-6'} />
</Section>
