---
// A text the site's owner writes: an optional heading and Markdown, in a panel when its heading has a colour (`sectionColor`).
import Section from '@theme/components/Section.astro';
import Markdown from '@theme/components/Markdown.astro';
import type { HomeSection } from '@morphemecms/cms/site/home';

// `lead`: its first paragraph is the lead (mo-type-lead), as the first paragraph of a page's text is: the text just under the front page's heading.
type Props = Extract<HomeSection, { type: 'text' }> & { class?: string; lead?: boolean; label?: string };
const { heading, body, sectionColor, class: className, lead, label } = Astro.props;
---

<Section title={heading} class={className} color={sectionColor} label={label}>
  <Markdown body={body} class:list={[heading && 'mo-text-after-heading', lead && 'mo-text-lead']} />
</Section>
