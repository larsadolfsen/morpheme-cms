---
// The site's logo (public/logo.svg) as a decorative mark. Size and colour come from the classes, the accent colour
// by default, e.g. <LogoMark class="mo-logo-mark-primary" />.
interface Props {
  class?: string;
}
const { class: className = 'mo-logo-mark-primary' } = Astro.props;
---

<span class:list={['mo-logo-mark', className]} aria-hidden="true"></span>
