---
// Title and intro at the top of the bespoke pages (prices, contact, services, blog, 404).
// Anything placed inside (e.g. category pills) goes below the intro.
import Container from '@theme/components/Container.astro';
import Inline from '@theme/components/Inline.astro';

interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<Container as="header" class="pt-8 md:pt-14">
  <h1 class="max-w-[18ch] text-[length:var(--theme-title-size,2.4rem)] leading-[var(--theme-title-leading,1.06)] md:text-[length:var(--theme-title-size-large,3.75rem)]">
    {title}
  </h1>
  {intro && (
    <p class="mt-4 max-w-[52ch] text-lg text-muted md:text-xl">
      <Inline text={intro} />
    </p>
  )}
  <slot />
</Container>
