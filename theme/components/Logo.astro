---
// The site's logo (public/butterfly.svg, "Tema" › "Logo og ikon") + its name and role ("Virksomheden"), in the theme's
// variables (--theme-logo-*, styles/components.css).
// The mark is a CSS mask over public/butterfly.svg, so it takes the theme's accent color
// and the 20 KB file is downloaded once and cached.
import Butterfly from '@theme/components/Butterfly.astro';
import { site } from '@interstellarcms/cms/site/site';

interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---

<span class="flex items-center gap-2.5">
  <span class="theme-logo-tile">
    <Butterfly class:list={['theme-logo-mark', size === 'sm' && 'theme-logo-mark-small']} />
  </span>
  <span class="leading-tight">
    <span class="theme-logo-name block tracking-tight">{site.name}</span>
    <span class="theme-logo-role text-[0.8rem] text-muted">{site.role}</span>
  </span>
</span>
