---
// The site's logo (public/logo.svg, "Tema" › "Logo og ikon") + its name and role ("Virksomheden"), in the theme's
// variables (--theme-logo-*, styles/site-logo-post.css).
// The mark is a CSS mask over public/logo.svg, so it takes the theme's accent color
// and the 20 KB file is downloaded once and cached.
import LogoMark from '@theme/components/LogoMark.astro';
import { site } from '@morphemecms/cms/site/site';

interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---

<span class="mo-row mo-logo">
  <span class="theme-logo-tile">
    <LogoMark class:list={['theme-logo-mark', size === 'sm' && 'theme-logo-mark-small']} />
  </span>
  <span class="mo-logo__text">
    <span class="theme-logo-name mo-logo__name">{site.name}</span>
    <span class="theme-logo-role mo-type-body-small mo-logo__role">{site.role}</span>
  </span>
</span>
