---
// A front-page section: container, spacing above, reveal on scroll and an optional heading + intro.
import Container from '@theme/components/Container.astro';
import SectionHeading from '@theme/components/SectionHeading';
import Inline from '@theme/components/Inline.astro';

interface Props {
  title?: string;
  intro?: string;
  class?: string;
  /** Id for the heading; the section is then labelled by it (aria-labelledby). */
  id?: string;
}
const { title, intro, class: className, id } = Astro.props;
---

<Container
  class:list={['pt-(--theme-section-space) md:pt-(--theme-section-space-large)', className]}
  aria-labelledby={title && id ? id : undefined}
  data-reveal
>
  {title && <SectionHeading id={id} text={title} />}
  {intro && (
    <p class="type-body-large mt-3 max-w-[52ch] text-muted">
      <Inline text={intro} />
    </p>
  )}
  <slot />
</Container>
