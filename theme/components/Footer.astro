---
// The footer at the bottom of every page (layouts/Base.astro): the practice, how to reach it and the practical links
// (footer.json, "På alle sider" › "Footer" in the editor), or what a page puts in the slot `footer-column` instead
// (a blog post's related posts), and at the bottom the CVR number (if any) and the buttons for the cookie settings and
// light or dark.
import Icon from '@theme/components/Icon.astro';
import Container from '@theme/components/Container.astro';
import Butterfly from '@theme/components/Butterfly.astro';
import footer from '@data/footer.json';
import { site } from '@interstellarcms/cms/site/site';
import { cookieBanner } from '@site/consent';

// "Cookieindstillinger": when the cookie banner is on and there is something to ask about (as in Base.astro).
const banner = cookieBanner;
const contactLinks = [
  { href: site.phoneHref, icon: 'phone', lines: [site.phone] },
  { href: `mailto:${site.email}`, icon: 'envelope-simple', lines: [site.email] },
  { href: `${site.contactPath}#find-vej`, icon: 'map-pin', lines: [site.address.street, site.address.city] },
];
const practicalLinks = footer.links;
---

<footer class="mt-24 border-t border-line md:mt-36">
  <Container as="div" class="grid gap-10 py-14 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Butterfly class="block h-12 w-11 bg-accent" />
      <p class="footer-name mt-3 text-2xl font-medium tracking-tight">{site.name}</p>
      <p class="mt-2 max-w-[38ch] text-muted">{footer.text}</p>
    </div>
    <div class="md:col-span-4">
      <p class="footer-heading font-medium">{footer.contactHeading}</p>
      <ul class="mt-3 space-y-2.5 text-muted">
        {contactLinks.map((c) => (
          <li>
            <a href={c.href} class="inline-flex items-start gap-2.5 hover:text-accent">
              <Icon name={c.icon} size={18} class="mt-1 shrink-0" />
              <span>
                {c.lines.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="md:col-span-3">
      {/* Blog posts put related posts here instead of the practical links. */}
      <slot name="footer-column">
        <p class="footer-heading font-medium">{footer.linksHeading}</p>
        <ul class="mt-3 space-y-2.5 text-muted">
          {practicalLinks.map((l) => (
            <li>
              <a href={l.href} class="hover:text-accent">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </slot>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-sm text-muted md:col-span-12">
      <span>
        © {new Date().getFullYear()} {site.name}
        {site.cvr && <> · CVR {site.cvr}</>}
      </span>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {banner && (
          <button type="button" data-cookie-settings class="rounded-full hover:text-ink">
            Cookieindstillinger
          </button>
        )}
        <button type="button" data-theme-toggle class="inline-flex items-center gap-2 rounded-full hover:text-ink">
          <Icon name="moon" size={16} class="dark-hide" />
          <Icon name="sun" size={16} class="light-hide" />
          <span class="dark-hide">Mørkt tema</span>
          <span class="light-hide">Lyst tema</span>
        </button>
      </div>
    </div>
  </Container>
</footer>
