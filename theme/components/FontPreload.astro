---
// The font files a theme loads before its CSS asks for them (<link rel="preload"> in Base.astro's <head>), so text
// renders without waiting for the CSS to be parsed: the standard theme's Plus Jakarta Sans (Latin).
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
---

<link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
