---
// The front page (the standard theme's): the page chosen under "Settings" › "Appearance" › "Default pages" (packages/editor/site/home.ts), its
// heading, then its sections in order: a text, and a block by its type in a section of its own (PageBlock.astro): the
// standard ones' and the apps', the top ("Hero") among them. A page whose H1 has section settings (a marker before it: a colour, a
// image behind the text, the whole width; the top "Banner" is migrated to this, lib/front-banner.mjs) draws the heading, its text and
// its Buttons block in one panel, as PageLayout.astro does, in place of the heading above.
import Base from '@theme/layouts/Base.astro';
import Container from '@theme/components/Container.astro';
import Text from '@theme/components/home/Text.astro';
import PageBlock from '@theme/components/home/PageBlock.astro';
import Markdown from '@theme/components/Markdown.astro';
import Img from '@theme/components/Img.astro';
import Block from '@morphemecms/cms/src/standard/Block.astro';
import { sectionClass } from '@morphemecms/cms/lib/text-sections.mjs';
import { blockTexts } from '@morphemecms/cms/site/site';
import { site } from '@morphemecms/cms/site/site';
import { picturesOf } from '@morphemecms/cms/site/images.mjs';
import type { FrontPage } from '@morphemecms/cms/site/home';

type Props = FrontPage;
const { page, heading, headingHtml, sections } = Astro.props;
// The sections before the H1's panel stay above it; the panel takes the place of the heading.
const panel = sections.find((s) => s.type === 'top');
---

<Base
  title={heading}
  description={page.data.description || site.description}
  seoTitle={page.data.seoTitle}
  seoDescription={page.data.seoDescription}
  canonical={page.data.canonical}
  noindex={page.data.noindex}
  shareImage={page.data.shareImage}
  images={picturesOf(page.body)}
  shareTitle={page.data.shareTitle}
  shareDescription={page.data.shareDescription}
>
  {!panel && (
    <Container class="pt-8 medium:pt-16">
      <h1 class="theme-title max-w-[22ch]">{headingHtml ? <Fragment set:html={headingHtml} /> : heading}</h1>
    </Container>
  )}
  {sections.map((s, i) => {
    const first = i === 0 ? 'theme-home-first' : undefined;
    if (s.type === 'top')
      return (
        <Container class={s.settings.color || s.settings.image ? '[&>.text-section]:mt-0' : 'pt-8 medium:pt-16'}>
          <section
            class={s.settings.color || s.settings.image || s.settings.width ? sectionClass(s.settings.color, s.settings) : undefined}
            data-editor="h1-section"
          >
            {s.settings.image && (
              <Img
                src={s.settings.image}
                alt={s.settings.alt ?? ''}
                sizes={s.settings.width === 'full' ? '100vw' : 'min(72rem, 100vw)'}
                class="text-section-image"
              />
            )}
            <h1 class="theme-title max-w-[22ch]">{headingHtml ? <Fragment set:html={headingHtml} /> : heading}</h1>
            {s.items.map((item, n) =>
              item.block ? (
                !item.block.props.hidden && (
                  <div class="block-place mt-6">
                    <Block type={item.block.type} props={item.block.props} texts={blockTexts[item.block.type]} />
                  </div>
                )
              ) : (
                <Markdown body={item.markdown} class={n === 0 ? 'mt-6 [&>p:first-child]:type-lead' : 'mt-6'} />
              ),
            )}
          </section>
        </Container>
      );
    return s.type === 'text' ? <Text {...s} class={first} lead={i === 0 && !s.heading} /> : <PageBlock section={s} class={first} />;
  })}
</Base>
