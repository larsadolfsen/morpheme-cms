---
// A tag's page on the blog (/blog/kategori/<slug>/, packages/editor/pages/blog/kategori/[category].astro): its posts.
import BlogIndex from '@theme/components/BlogIndex.astro';
import BlogPosts from '@theme/components/BlogPosts.astro';
import type { Post } from '@interstellarcms/cms/site/content';

interface Props {
  /** The tag's slug, its name, and its posts. */
  category: string;
  name: string;
  posts: Post[];
}
const { category, name, posts } = Astro.props;
---

<BlogIndex
  title={name}
  intro={`${posts.length} ${posts.length === 1 ? 'indlæg' : 'indlæg'} om ${name.toLowerCase()}.`}
  activeCategory={category}
>
  <BlogPosts posts={posts} />
</BlogIndex>
