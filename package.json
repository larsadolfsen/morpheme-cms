{
  "name": "@morphemecms/cms",
  "version": "0.17.0",
  "description": "Morpheme CMS: the editor for a site built with Astro, its screens, its blocks and the rules a site gives it. See README.md.",
  "license": "MIT",
  "author": "Lars Adolfsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larsadolfsen/morpheme-cms.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "astro.mjs",
    "astro.d.mts",
    "client.d.ts",
    "bin",
    "defaults",
    "demo",
    "icons",
    "lib",
    "!lib/fixtures",
    "!lib/sandbox/fixtures",
    "pages",
    "release-notes",
    "scripts",
    "!scripts/starter.mjs",
    "!scripts/check-starter.mjs",
    "!scripts/demo-build.mjs",
    "site",
    "src",
    "starter",
    "theme",
    "worker"
  ],
  "type": "module",
  "bin": {
    "morpheme": "bin/morpheme.mjs"
  },
  "scripts": {
    "build": "node scripts/demo-build.mjs",
    "check": "npm run format:check && npm run check:language && npm run check:phosphor && npm run check:editor-colors && npm run check:colors && npm run check:css-values && npm run check:density && npm run check:release-notes && npm test && npm run check:types && npm run build && npm run check:site-types && npm run check:editor",
    "check:site-types": "node scripts/check-site-types.mjs",
    "check:types": "tsc -p tsconfig.types.json --noEmit",
    "check:editor": "cd .morpheme/demo/site && node ../../../bin/morpheme.mjs check:editor",
    "check:screens": "npm run check:screens:shard -- 1/1 && npm run check:screens:extra",
    "check:screens:shard": "cd .morpheme/demo/site && node ../../../bin/morpheme.mjs check:screens --shard",
    "check:screens:extra": "cd .morpheme/demo/site && node ../../../scripts/check-save-twice.mjs && node ../../../scripts/check-unlisted.mjs && node ../../../scripts/check-preview.mjs && node ../../../scripts/check-imagegrid.mjs && node ../../../scripts/check-test-page.mjs",
    "check:preview": "cd .morpheme/demo/site && node ../../../bin/morpheme.mjs check:preview",
    "check:contrast": "cd .morpheme/demo/site && node ../../../bin/morpheme.mjs check:contrast",
    "check:demo": "node bin/morpheme.mjs check:demo",
    "check:starter": "node scripts/check-starter.mjs",
    "test": "node --test \"{lib,scripts,site,src,theme,worker}/**/*.test.mjs\"",
    "icons": "node scripts/icon-packs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:language": "node scripts/check-language.mjs",
    "check:phosphor": "node scripts/check-phosphor.mjs",
    "check:editor-colors": "node scripts/check-editor-colors.mjs",
    "check:css-values": "node scripts/check-css-values.mjs",
    "check:density": "node scripts/check-density.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "release:version": "changeset version && node scripts/release-notes.mjs && node scripts/starter.mjs",
    "prepack": "node scripts/types.mjs write",
    "postpack": "node scripts/types.mjs clean"
  },
  "peerDependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/react": "^7.1.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/roboto": "^5.3.0",
    "@material-symbols/svg-400": "0.48.2",
    "@material/material-color-utilities": "^0.3.0",
    "@milkdown/kit": "^7.23.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "jsdom": "^29.1.1 || ^31.0.0",
    "motion": "^14.12.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^6.1.5 || ^7.2.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/react": "^7.1.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/roboto": "^5.3.0",
    "@material-symbols/svg-400": "0.48.2",
    "@material/material-color-utilities": "^0.3.0",
    "@milkdown/kit": "^7.23.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "jsdom": "^29.1.1 || ^31.0.0",
    "motion": "^14.12.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^6.1.5 || ^7.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.2.0"
    }
  }
}
